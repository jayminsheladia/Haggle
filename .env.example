# Copy to .env and fill in. Never commit .env.

# LLM (ASI:One)
ASI1_API_KEY=

# Agentverse
AGENTVERSE_API_KEY=
# Optional override of the HaggleNegotiation digest (default: PROTOCOL_DIGEST in vendors/template.py)
NEGOTIATION_PROTOCOL_DIGEST=
# Discovery agent address the Concierge sends searches to (defaults to the one in the README)
DISCOVERY_ADDRESS=
# Negotiator agent address the Concierge sends quote requests to (defaults to the one in the README)
NEGOTIATOR_ADDRESS=
# Vendor Agent Factory address the Concierge sends onboarding requests to
FACTORY_ADDRESS=

# Stripe (test mode)
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=

# Google Places (New)
GOOGLE_PLACES_API_KEY=

# Email
RESEND_API_KEY=

# Photon
PHOTON_API_KEY=
PHOTON_PROJECT_ID=

# Sentry
SENTRY_DSN=
SENTRY_DSN_BRIDGE=

# Agent seeds (long random strings; same seed = same address forever)
CONCIERGE_SEED=
DISCOVERY_SEED=
FACTORY_SEED=
NEGOTIATOR_SEED=
BOOKER_SEED=
FOLLOWUP_SEED=
VENDOR_SEED_SECRET=

# Development: all emails / texts / calls go here only
TEAM_INBOX_EMAIL=
TEAM_PHONE=
# Vendor owner notifications (approvals, claim codes) go only to these during development
OWNER_TEST_PHONE=
OWNER_TEST_EMAIL=

# Vendor host
# 1 = also host the claimed demo vendors from vendors/fixtures
HOST_DEMO_VENDORS=
# Defaults: REST on 8109, vendor agents from 8110 up; minutes an owner has to answer an approval
VENDOR_HOST_PORT=
VENDOR_PORT_BASE=
APPROVAL_TTL_MIN=
