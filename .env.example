# Copy to .env and fill in. Never commit .env.

# LLM (ASI:One)
ASI1_API_KEY=

# Agentverse
AGENTVERSE_API_KEY=
# Optional override of the HaggleNegotiation digest (default: PROTOCOL_DIGEST in vendors/template.py)
NEGOTIATION_PROTOCOL_DIGEST=
# Discovery agent address the Concierge sends searches to (defaults to the one in the README)
DISCOVERY_ADDRESS=
# Negotiator agent address the Concierge sends quote requests to (defaults to the one in the README)
NEGOTIATOR_ADDRESS=
# Vendor Agent Factory address the Concierge sends onboarding requests to
FACTORY_ADDRESS=
# Booker address the Concierge sends paid bookings to (defaults to the one in the README)
BOOKER_ADDRESS=
# Concierge address the Booker accepts bookings from (defaults to the one in the README)
CONCIERGE_ADDRESS=

# Stripe (test mode)
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
# 1 = mock the deposit: a real Stripe test-mode charge with Stripe's test card, no checkout UI
STRIPE_MOCK_PAYMENTS=
# Optional: where Stripe returns after checkout (default https://asi1.ai); checkout lifetime, min 1800
STRIPE_SUCCESS_URL=
STRIPE_CHECKOUT_EXPIRES_SECONDS=

# Google Places (New)
GOOGLE_PLACES_API_KEY=
# Web search for menus on other sites (optional; first one set is used, else DuckDuckGo)
SERPER_API_KEY=
TAVILY_API_KEY=

# Email
RESEND_API_KEY=
# Optional sender; default Haggle <onboarding@resend.dev> (Resend's test sender)
RESEND_FROM=

# Photon
PHOTON_API_KEY=
PHOTON_PROJECT_ID=
# Our Photon line's user id (sender), and imessage | sms
PHOTON_SENDER_ID=
PHOTON_PLATFORM=

# Sentry
SENTRY_DSN=
SENTRY_DSN_BRIDGE=

# Agent seeds (long random strings; same seed = same address forever)
CONCIERGE_SEED=
DISCOVERY_SEED=
FACTORY_SEED=
NEGOTIATOR_SEED=
BOOKER_SEED=
FOLLOWUP_SEED=
VENDOR_SEED_SECRET=

# Development: all emails / texts / calls go here only
TEAM_INBOX_EMAIL=
TEAM_PHONE=
# Vendor owner notifications (approvals, claim codes) go only to these during development
OWNER_TEST_PHONE=
OWNER_TEST_EMAIL=
# Emails meant for a caterer (quote requests, orders) go here during development
VENDOR_TEST_EMAIL=

# Vendor host
# 1 = also host the claimed demo vendors from vendors/fixtures
HOST_DEMO_VENDORS=
# Defaults: REST on 8109, vendor agents from 8110 up; minutes an owner has to answer an approval
VENDOR_HOST_PORT=
VENDOR_PORT_BASE=
APPROVAL_TTL_MIN=
